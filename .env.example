# ============ NoneBot2 基础配置 ============
DRIVER=~fastapi+~httpx+~websockets
HOST=127.0.0.1
PORT=6188

# 超级用户：可执行"白纸bot总控插件"命令的 QQ 号（JSON 数组格式，必填！）
SUPERUSERS=["123456789"]

# 命令前缀（JSON 数组格式）——本项目命令以 % 开头
COMMAND_START=["%"]

# ============ OneBot v11 / SnowLuma ============
# 正向 WS：NoneBot 主动连接 SnowLuma 的 OneBot 服务端
# 例：ONEBOT_WS_URLS=["ws://<服务器IP>:3001"]
ONEBOT_WS_URLS=[]
# OneBot 访问令牌（从 SnowLuma WebUI 获取，勿提交到仓库！）
ONEBOT_ACCESS_TOKEN=

# ============ PaperBot 项目自定义 ============
# 共享数据库（所有插件共用，方便互相联动数据）
DATABASE_URL=sqlite+aiosqlite:///data/paperbot.db
# WebUI 后端开关
WEBUI_ENABLE=true
WEBUI_PREFIX=/api
# WebUI 访问令牌，留空则不做鉴权（本地开发可留空，公网部署务必设置）
WEBUI_TOKEN=

# ============ 日志（终端 + 每次运行的日志文件） ============
# 终端日志级别
LOG_LEVEL=INFO
# 是否把日志写入 logs/ 目录（每次运行一个独立文件，便于事后排查）
LOG_FILE_ENABLE=true
# 文件日志级别（建议 DEBUG，排查更细）
LOG_FILE_LEVEL=DEBUG
LOG_DIR=logs
# 启动时自动清理超过 N 天的日志（<=0 表示不清理）
LOG_KEEP_DAYS=7

# ============ 消息安全：门控默认策略 + 输出守卫（共用同一份群白名单） ============
# 允许 Bot 活跃/说话的白名单群（唯一来源）
# ⚠️ 留空 = 不向任何群发消息（安全默认），请按需填写
BOT_ACTIVE_GROUPS=[]
# 框架级默认门控（未配置规则的群怎么处理）
#   true  = 跟随插件自己的 default_enabled（默认，宽松）
#   false = 全局默认禁用，只有 BOT_ACTIVE_GROUPS 里的群才跟随插件默认值（推荐开发期）
GATE_DEFAULT_ENABLED=true
# 消息输出守卫：开发测试期锁死消息出口（私聊一律拦截）
OUTPUT_GUARD_ENABLED=true

# ============ 渲染（Markdown/文本 → 图片） ============
# 卡片宽度（像素）与截图缩放倍数（2 = 高清）
RENDER_WIDTH=720
RENDER_SCALE=2
# 浏览器来源：本地复用系统 Edge 用 msedge；搬服务器可改 chromium 或留空走内置
RENDER_BROWSER_CHANNEL=msedge
# 指定浏览器可执行文件路径（非空时优先于 channel，例：/usr/bin/chromium）
RENDER_BROWSER_PATH=
# OC 背景贴图（半透明叠在卡片右下角），留空则不叠图
RENDER_BG_IMAGE=assets/Q-OC.png
RENDER_BG_IMAGE_OPACITY=0.22
RENDER_BG_IMAGE_SIZE=58%
RENDER_BG_IMAGE_POSITION="bottom right"

# ============ LLM（统一大模型服务） ============
# 总开关：关闭后插件调用 LLM 会直接报错
LLM_ENABLE=true
# 兜底服务商（DB 里没有启用的服务商时才会用到；推荐用 WebUI「LLM 与记忆」页管理）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# 请求超时（秒）与代理（本机 Clash 例：http://127.0.0.1:2080，留空直连）
LLM_TIMEOUT=60
LLM_PROXY=
# 采样参数（max_tokens=0 表示不传，交给服务端默认）
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=0
# 默认人设名（未显式指定时用它，内置示例：paper_white）
LLM_DEFAULT_PRESET=
# 流式输出总开关（插件显式传 use_stream 时以插件为准）
LLM_STREAM_ENABLE=false
# 长期记忆：是否注入「用户印象 + 关键信息」
LLM_MEMORY_ENABLE=true
# 上下文轮数（1 轮 = 用户 + 助手）
LLM_CONTEXT_ROUNDS=10
# 最多往提示词里塞几条关键信息
LLM_MAX_FACTS=30
# 单个用户在单个 scope 内的库内事实条数上限（超出按最旧优先淘汰）
LLM_MAX_FACTS_STORED=200
# 记忆跨窗口隔离：群聊只看到通用 + 本群信息，不再看到私聊 / 别群内容
LLM_MEMORY_SCOPE_ISOLATION=true
# 记忆注入「分槽保底」：通用画像 / 窗口事实 分槽，每槽至少保留若干条
LLM_MEMORY_SLOTS_ENABLE=true
# 受控 key 词表：auto 提炼时未命中词表的自造 key 直接丢弃（false = 放行原样）
LLM_MEMORY_KEY_EXACT=true
# 记忆用法档：注入时按 mention/tone/uncertain 分组渲染（false = 忽略档位、单列表）
LLM_MEMORY_USAGE_ENABLE=true
# 记忆半衰期软衰减 + 复述加固（只降权不删；越久没用越淡，被召回后回血）
LLM_MEMORY_DECAY_ENABLE=true
# 通用事实半衰期（天）
LLM_MEMORY_DECAY_HALF_LIFE_GLOBAL=60
# 窗口事实半衰期（天）
LLM_MEMORY_DECAY_HALF_LIFE_WINDOW=30
# 每次被注入的权重回血量
LLM_MEMORY_DECAY_REINFORCE=0.2
# 强化写库节流（秒，默认 6 小时）
LLM_MEMORY_DECAY_TOUCH_INTERVAL=21600

# ============ 聊天记录（原始流水层） ============
# 全局钩子把收到的消息（群 + 私聊，含 bot 自己的）逐条写入 chat_message 表
CHATLOG_ENABLE=true
# 聊天流水归档（冷区）：保留期外、且已过提炼水位线的老消息搬进 chat_message_archive
CHATLOG_ARCHIVE_ENABLE=true
# 主表保留最近 N 天（更老的进冷区）
CHATLOG_RETENTION_DAYS=90
# 每日每批最多搬多少条（防长事务）
CHATLOG_ARCHIVE_BATCH=5000

# ============ 定时记忆总结 + 上下文压缩 ============
# 总开关：关闭后不跑定时总结与压缩
LLM_SUMMARY_ENABLE=true
# 总结周期（秒），默认 30 分钟
LLM_SUMMARY_INTERVAL=1800
# 总结用服务商 / 模型（留空 = 用默认服务商；建议单独配一个便宜模型）
LLM_SUMMARY_PROVIDER=
LLM_SUMMARY_MODEL=
# 单次总结最多取多少条增量（超过则只取最近这些，水位线直推最新）
LLM_SUMMARY_MAX_MSGS=300
# 触发压缩的会话消息条数；实际保留窗口 = 2×LLM_CONTEXT_ROUNDS（与注入窗口对齐）
LLM_COMPRESS_THRESHOLD=20

# ============ 版本控制（WebUI 设置页「一键更新」） ============
# 用途：本地开发机 push → 服务器生产环境在 WebUI 点一下拉取最新代码
# 只拉不推，且绝不碰 .config/ data/ logs/（这些目录已 gitignore，更新时不受影响）
VCS_ENABLE=true
# 远程名与跟踪分支
VCS_REMOTE=origin
VCS_BRANCH=main
# 远程地址：留空 = 用仓库已有的 origin；首次部署可填公开仓库 HTTPS 地址
VCS_REMOTE_URL=
# fetch 代理（如 http://127.0.0.1:2080），留空直连
VCS_PROXY=
# 提交历史展示条数
VCS_LOG_LIMIT=30
# 重启模式：spawn = 自己拉起新进程（开箱即用）；exit = 交给守护进程（systemd/NSSM）拉起
VCS_RESTART_MODE=spawn
# 守护服务名（如 paperbot.service / PaperBot），留空则不检测守护状态
VCS_SERVICE_NAME=
